# Copie para .env e ajuste.
# No cPanel, o banco e o usuário são criados em "Bancos de dados PostgreSQL".
DATABASE_URL=postgres://usuario:senha@localhost:5432/projetos

# Endereço público do sistema (usado nos links dos e-mails).
APP_URL=https://projetos.intotumse.com.br

# E-mail de envio (conta criada em "Contas de e-mail" do cPanel).
# Sem SMTP_HOST, o sistema não envia e mostra o link do convite na tela.
SMTP_HOST=mail.intotumse.com.br
SMTP_PORT=465
SMTP_USER=projetos@intotumse.com.br
SMTP_PASS=
MAIL_FROM="Intotum Projetos <projetos@intotumse.com.br>"
